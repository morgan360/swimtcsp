# Static & Media
# Do NOT ignore /static/ — it contains source static files (e.g. Tailwind)
# /media/ is not ignored; add below if you use uploaded media in dev
# /media/

# Collected static output (generated by collectstatic)
# These folders are used in production but should not be committed
/static_files/
/staticfiles/
/staticfiles_build/
*.css.map
*.js.map

# Tailwind build artifacts
*.tmp.css
*.tmp.*
*.postcss*

# Environment Variables
.env
.env.*

